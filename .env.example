# ─── Frontend (Vite) ────────────────────────────────────────────────
# Sólo estas dos viajan al bundle del navegador.
# Project Settings → API en https://supabase.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Sólo scripts de Node ────────────────────────────────────────────
# NUNCA usar desde el navegador: saltea las políticas RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Supabase CLI ────────────────────────────────────────────────────
# Aparece en la URL del proyecto: supabase.co/dashboard/project/<ref>
SUPABASE_PROJECT_REF=